# Unified deployment environment
# Copy this file to .env and replace every required placeholder before production use.
# Generate secrets with: openssl rand -hex 32

# Laravel application key. Generate with: openssl rand -base64 32
APP_KEY=base64:replace-with-a-32-byte-laravel-key

# Backend and database secrets
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-strong-jwt-secret
BACKEND_INTERNAL_TOKEN=replace-with-a-strong-backend-token

# Initial administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# FreeSWITCH ESL password. Must be shared with the backend.
FREESWITCH_PASSWORD=replace-with-a-strong-freeswitch-password

# Optional network overrides. Leave empty for automatic detection.
FREESWITCH_EXTERNAL_SIP_IP=
FREESWITCH_EXTERNAL_RTP_IP=
FREESWITCH_BIND_IP=
FREESWITCH_HOST=
FREESWITCH_DIRECTORY_DOMAIN=


# Optional RTP/RTCP UDP media port range. Leave empty to use the default 4000-6000.
RTP_START_PORT=
RTP_END_PORT=

# Optional VICIdial browser phone + Agent API (see laravel/README.md).
VICIDIAL_ENABLED=false
VICIDIAL_API_URL=https://vici.example.com/agc/api.php
VICIDIAL_API_USER=
VICIDIAL_API_PASSWORD=
VICIDIAL_AGENT_URL=https://vici.example.com/agc/vicidial.php
VICIDIAL_WSS_URL=wss://vici.example.com:8089/ws
VICIDIAL_SIP_DOMAIN=vici.example.com
VICIDIAL_ICE_SERVERS='[]'
# Keys are local application user IDs. Use the VICIdial phone SIP credentials.
VICIDIAL_AGENTS='{}'
# Only ordinary disposition codes; use the VICIdial screen for scheduled callbacks.
VICIDIAL_DISPOSITIONS=

# Optional PEM CA file for a private VICIdial HTTPS endpoint (container path).
VICIDIAL_CA_BUNDLE=
