# Unified deployment environment
# Dedicated VICIdial customer-to-AI route (one SIP leg per customer).
# Keep disabled until remote-agent call lifecycle and fallback are verified.
VICIDIAL_CUSTOMER_AI_ENABLED=false
VICIDIAL_CUSTOMER_AI_AGENTS=
# Optional exact source IP observed by FreeSWITCH after private-network NAT.
# Empty uses VICIDIAL_AI_SERVER_IP; does not change the conference worker IP.
VICIDIAL_CUSTOMER_AI_SOURCE_IP=
# Copy this file to .env and replace every required placeholder before production use.
# Generate secrets with: openssl rand -hex 32

# Laravel application key. Generate with: openssl rand -base64 32
APP_KEY=base64:replace-with-a-32-byte-laravel-key

# Backend and database secrets
DB_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-strong-jwt-secret
BACKEND_INTERNAL_TOKEN=replace-with-a-strong-backend-token

# Initial administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# FreeSWITCH ESL password. Must be shared with the backend.
FREESWITCH_PASSWORD=replace-with-a-strong-freeswitch-password

# Optional network overrides. Leave empty for automatic detection.
FREESWITCH_EXTERNAL_SIP_IP=
FREESWITCH_EXTERNAL_RTP_IP=
FREESWITCH_BIND_IP=
FREESWITCH_HOST=
FREESWITCH_DIRECTORY_DOMAIN=


# Optional RTP/RTCP UDP media port range. Leave empty to use the default 4000-6000.
RTP_START_PORT=
RTP_END_PORT=

# Optional VICIdial browser phone + Agent API (see laravel/README.md).
VICIDIAL_ENABLED=false
VICIDIAL_API_URL=https://vici.example.com/agc/api.php
VICIDIAL_API_USER=
VICIDIAL_API_PASSWORD=
VICIDIAL_AGENT_URL=https://vici.example.com/agc/vicidial.php
VICIDIAL_WSS_URL=wss://vici.example.com:8089/ws
VICIDIAL_SIP_DOMAIN=vici.example.com
VICIDIAL_ICE_SERVERS='[]'
# Keys are local application user IDs. Use the VICIdial phone SIP credentials.
VICIDIAL_AGENTS='{}'
# Only ordinary disposition codes; use the VICIdial screen for scheduled callbacks.
VICIDIAL_DISPOSITIONS=
# Approved exact VICIdial dialplan numbers, e.g. {"supervisor":"8500"}.
# An AI target needs an actual audio endpoint; a name alone does not create one.
VICIDIAL_CONFERENCE_TARGETS='{}'

# Optional PEM CA file for a private VICIdial HTTPS endpoint (container path).
VICIDIAL_CA_BUNDLE=

# Inbound AI conference worker (see scripts/vicidial-ai/README.md).
VICIDIAL_AI_ENABLED=false
VICIDIAL_AI_SERVER_IP=172.16.253.142
VICIDIAL_AI_SYNC_TOKEN=

# CRM report tool stays disabled until a reviewed CRM adapter/config is ready.
CRM_REPORTS_ENABLED=false
CRM_REPORTS_CONFIG=/etc/crm-reports/reports.json
CRM_STORAGE_STATE=/etc/crm-reports/auth.json
CRM_CHROMIUM_EXECUTABLE=

# Test CRM is isolated and disabled by default. Use a random token of at least 32 characters.
TEST_CRM_ENABLED=false
TEST_CRM_API_TOKEN=
# Same-app lab example: http://127.0.0.1:8080/api/test-crm/v1
CRM_API_URL=
CRM_API_TOKEN=
